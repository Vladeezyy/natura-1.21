{
  "multipart": [
    {
      "apply": {
        "model": "natura:block/saguaro"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "natura:block/saguaro_side",
        "uvlock": true
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "natura:block/saguaro_side",
        "uvlock": true,
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "natura:block/saguaro_side",
        "uvlock": true,
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "natura:block/saguaro_side",
        "uvlock": true,
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "natura:block/saguaro_top",
        "uvlock": true
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "natura:block/saguaro_bottom",
        "uvlock": true
      }
    }
  ]
}
