{
  "multipart": [
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "natura:block/thorn_vines_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "natura:block/thorn_vines_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "natura:block/thorn_vines_side",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "natura:block/thorn_vines_side",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "natura:block/thorn_vines_up"
      }
    }
  ]
}
